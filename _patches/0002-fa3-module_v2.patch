+# examples/gpt_layer_spec_fa3.py
+#
+# Custom layer spec for GPT pretraining that swaps core_attention to
+# FA3DotProductAttention while reusing every other submodule from the
+# standard local (non-TE) spec in gpt_layer_specs.py.
+#
+# Usage — pass to pretrain_gpt.py via --spec:
+#
+#   torchrun ... pretrain_gpt.py \
+#       --use-mcore-models \
+#       --transformer-impl local \
+#       --spec examples.gpt_layer_spec_fa3.get_gpt_layer_fa3_spec \
+#       ...
+#
+# import_module() (called by model_provider) imports the dotted path and
+# calls the function with no arguments, so the function must return a
+# ModuleSpec directly.
+
+from megatron.core.models.gpt.gpt_layer_specs import get_gpt_layer_with_transformer_engine_spec
+from megatron.core.transformer.spec_utils import ModuleSpec
+from megatron.core.transformer.attention import SelfAttention, SelfAttentionSubmodules
+from megatron.training import get_args
+
+# FA3 kernel — place this file next to fa3_dot_product_attention.py
+# (or adjust the import path to wherever you put it in your repo).
+from megatron.fa3.fa3_dot_product_attention import FA3DotProductAttention
+
+"""
+Return a TransformerLayer ModuleSpec identical to get_gpt_layer_local_spec()
+except that core_attention is replaced with FA3DotProductAttention.
+
+Strategy:
+    1. Fetch the canonical local spec (no TransformerEngine dependency).
+    2. Reach into the self_attention submodules and swap core_attention in place.
+        This preserves every other submodule (linear_qkv, linear_proj,
+        q_layernorm, k_layernorm, pre/post norms, MLP, BDA functions, …)
+        exactly as Megatron configures them for GPT.
+"""
+print(f"[fa3_spec] Build GPT Layer spec")
+args = get_args()
+get_gpt_layer_fa3_spec = get_gpt_layer_with_transformer_engine_spec(
+    args.num_experts,
+    args.moe_grouped_gemm,
+    args.qk_layernorm,
+    args.multi_latent_attention,
+    args.experimental_attention_variant,
+    moe_use_legacy_grouped_gemm=args.moe_use_legacy_grouped_gemm,
+    qk_l2_norm=args.qk_l2_norm,
+)
+print(f"[fa3_spec] spec={get_gpt_layer_fa3_spec}", flush=True)
+
+# get_gpt_layer_local_spec() returns a ModuleSpec whose submodules field
+# is a TransformerLayerSubmodules dataclass.  self_attention is itself a
+# ModuleSpec(module=SelfAttention, submodules=SelfAttentionSubmodules(...)).
+# SelfAttentionSubmodules is a plain dataclass — mutate core_attention.
+get_gpt_layer_fa3_spec.submodules.self_attention.submodules.core_attention = FA3DotProductAttention
